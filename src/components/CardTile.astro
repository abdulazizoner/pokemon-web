---
import type { CollectionEntry } from "astro:content";
const { card } = Astro.props as { card: CollectionEntry<"cards"> };
const d = card.data;
const detailUrl = `/kartlar/${card.id}`;
const availability = { available: "Satışta", reserved: "Rezerve", sold: "Satıldı" }[d.availability];
---

<article class="card-tile" data-card data-search={`${d.name} ${d.setName} ${d.rarity}`.toLowerCase()} data-condition={d.condition} data-language={d.language} data-availability={d.availability}>
  <div class="card-visual">
    <a href={detailUrl} aria-label={`${d.name} detayını görüntüle`}>
      <img class="card-front" src={d.frontImage} alt={`${d.name} ön yüz temsili görseli`} width="600" height="840" loading="lazy" />
      <img class="card-back" src={d.backImage} alt={`${d.name} arka yüz temsili görseli`} width="600" height="840" loading="lazy" />
    </a>
    <span class:list={["status", d.availability]}>{availability}</span>
    <button class="flip-button" type="button" data-flip aria-pressed="false">Arkayı göster</button>
  </div>
  <div class="card-meta">
    <p class="overline">{d.setName} · {d.collectorNumber}</p>
    <h3><a href={detailUrl}>{d.name}</a></h3>
    <div class="tag-row"><span>{d.condition}</span><span>{d.language}</span></div>
    <div class="price-row"><strong>{d.displayPrice}</strong><a href={detailUrl}>İncele <span aria-hidden="true">↗</span></a></div>
  </div>
</article>
