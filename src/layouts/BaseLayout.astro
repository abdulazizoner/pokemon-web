---
import { store } from "../config/store";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  ogType?: "website" | "product";
  jsonLd?: Record<string, unknown> | Array<Record<string, unknown>>;
}
const {
  title = store.name,
  description = store.description,
  noindex = false,
  ogType = "website",
  jsonLd,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, store.siteUrl);
const socialImage = new URL("/og.png", store.siteUrl);
const fullTitle = title === store.name ? title : `${title} — ${store.name}`;
const currentPath = Astro.url.pathname.replace(/\/+$/, "") || "/";
const navigationItems = [
  { href: "/kartlar", label: "Kartlar" },
  { href: "/hakkimizda", label: "Hakkımızda" },
  { href: "/sss", label: "SSS" },
  { href: "/iletisim", label: "İletişim" },
];
const isCurrent = (href: string) =>
  currentPath === href || (href !== "/" && currentPath.startsWith(`${href}/`));
---

<!doctype html>
<html lang="tr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="tr_TR" />
    <meta property="og:site_name" content={store.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="theme-color" content="#f4f0e8" />
    <title>{fullTitle}</title>
    {jsonLd && <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <a class="skip-link" href="#icerik">İçeriğe geç</a>
    {
      store.isPlaceholderBrand && (
        <aside class="preview-banner" aria-label="Ön izleme bildirimi">
          Ön izleme · Marka ve ürün bilgileri temsili
        </aside>
      )
    }
    <header class="site-header">
      <a class="brand" href="/" aria-current={currentPath === "/" ? "page" : undefined}>
        <span class="brand-mark" aria-hidden="true">P/A</span>
        <span>{store.name}</span>
        <span class="sr-only"> ana sayfa</span>
      </a>
      <nav aria-label="Ana menü">
        {
          navigationItems.map((item) => (
            <a href={item.href} aria-current={isCurrent(item.href) ? "page" : undefined}>
              {item.label}
            </a>
          ))
        }
      </nav>
      <details class="mobile-nav">
        <summary aria-controls="mobil-menu-baglantilari">Menü</summary>
        <nav id="mobil-menu-baglantilari" aria-label="Mobil menü">
          {
            navigationItems.slice(0, 3).map((item) => (
              <a href={item.href} aria-current={isCurrent(item.href) ? "page" : undefined}>
                {item.label}
              </a>
            ))
          }
          <a href="/kargo-ve-iade">Kargo ve iade</a>
          <a href="/iletisim" aria-current={isCurrent("/iletisim") ? "page" : undefined}>İletişim</a
          >
        </nav>
      </details>
      <a class="button button-compact" href="/kartlar">Arşivi keşfet</a>
    </header>
    <main id="icerik"><slot /></main>
    <footer class="site-footer">
      <div><span class="brand-mark" aria-hidden="true">P/A</span><strong>{store.name}</strong></div>
      <p>{store.legalDisclaimer}</p>
      <div class="footer-links">
        <a href="/kartlar">Kartlar</a><a href="/kargo-ve-iade">Kargo ve iade</a><a href="/iletisim"
          >İletişim</a
        >
      </div>
    </footer>
    <script>
      document.querySelectorAll<HTMLButtonElement>("[data-flip]").forEach((button) => {
        button.addEventListener("click", () => {
          const card = button.closest<HTMLElement>("[data-card]");
          card?.classList.toggle("is-flipped");
          button.setAttribute("aria-pressed", String(card?.classList.contains("is-flipped")));
          button.textContent = card?.classList.contains("is-flipped")
            ? "Önü göster"
            : "Arkayı göster";
        });
      });

      const mobileNav = document.querySelector<HTMLDetailsElement>(".mobile-nav");
      const mobileSummary = mobileNav?.querySelector<HTMLElement>("summary");
      mobileNav?.querySelectorAll("a").forEach((link) => {
        link.addEventListener("click", () => mobileNav.removeAttribute("open"));
      });
      mobileNav?.addEventListener("keydown", (event) => {
        if (event.key === "Escape" && mobileNav.open) {
          mobileNav.removeAttribute("open");
          mobileSummary?.focus();
        }
      });
    </script>
  </body>
</html>
