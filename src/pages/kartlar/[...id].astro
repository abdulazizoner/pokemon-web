---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
export async function getStaticPaths() {
  const cards = await getCollection("cards");
  return cards.map(card => ({ params: { id: card.id }, props: { card } }));
}
const { card } = Astro.props;
const { Content } = await render(card);
const d = card.data;
---
<BaseLayout title={d.name} description={`${d.name}, ${d.setName}, ${d.condition} kondisyon koleksiyon kartı.`}>
  <section class="product shell">
    <div class="product-gallery"><img src={d.frontImage} alt={`${d.name} ön yüz`} width="600" height="840" /><img src={d.backImage} alt={`${d.name} arka yüz`} width="600" height="840" /></div>
    <div class="product-info">
      <a class="back-link" href="/kartlar">← Tüm kartlar</a><p class="eyebrow">{d.setName} · {d.collectorNumber}</p><h1>{d.name}</h1><p class="product-price">{d.displayPrice}</p>
      <dl><div><dt>Kondisyon</dt><dd>{d.condition}</dd></div><div><dt>Dil</dt><dd>{d.language}</dd></div><div><dt>Nadirlik</dt><dd>{d.rarity}</dd></div><div><dt>Yüzey</dt><dd>{d.finish}</dd></div></dl>
      <div class="condition-note"><h2>Kondisyon notu</h2><p>{d.conditionNote}</p></div>
      <a class:list={["button","buy-button", d.availability !== "available" && "disabled"]} href={d.shopierUrl} target="_blank" rel="noopener noreferrer" aria-disabled={d.availability !== "available"}>{d.availability === "available" ? "Shopier’de satın al ↗" : "Şu anda satışta değil"}</a>
      <p class="fine-print">Ödeme, sipariş ve güncel stok kontrolü Shopier üzerinde tamamlanır.</p><Content />
    </div>
  </section>
</BaseLayout>
